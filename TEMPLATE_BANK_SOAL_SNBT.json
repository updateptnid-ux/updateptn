        "questions": [
          {
            "question_id": "PK-001",
            "question_number": 1,
            "question_text": "Jika x + y = 10 dan x - y = 4, maka nilai x² + y² adalah...",
            "question_type": "multiple_choice",
            "difficulty_level": "hard",
            "irt_discrimination": 1.8,
            "irt_difficulty": 1.0,
            "cognitive_level": "C4-Analisis",
            "topic": "Aljabar",
            "subtopic": "Sistem Persamaan Linear",
            "image_url": null,
            "options": [
              {
                "option_id": "A",
                "option_text": "52",
                "is_correct": false
              },
              {
                "option_id": "B",
                "option_text": "58",
                "is_correct": true
              },
              {
                "option_id": "C",
                "option_text": "64",
                "is_correct": false
              },
              {
                "option_id": "D",
                "option_text": "72",
                "is_correct": false
              }
            ],
            "explanation": {
              "correct_answer": "B",
              "explanation_text": "Dari x+y=10 dan x-y=4, didapat x=7 dan y=3. Maka x²+y² = 7² + 3² = 49 + 9 = 58",
              "solution_steps": [
                "Eliminasi: (x+y) + (x-y) = 2x = 14 → x = 7",
                "Substitusi: 7 + y = 10 → y = 3",
                "Hitung: x² + y² = 49 + 9 = 58"
              ],
              "time_estimate_seconds": 120,
              "tips": "Gunakan eliminasi untuk mencari x, lalu substitusi untuk y."
            }
          }
        ]
      }
